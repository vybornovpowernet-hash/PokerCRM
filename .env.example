# === Poker CRM: пример переменных окружения ===
# Этот файл — безопасный шаблон БЕЗ секретов.
# При первом запуске start.bat автоматически скопирует его в .env,
# если файла .env ещё нет. Правьте уже .env, не .env.example.

# Порт API-сервера (Fastify). По умолчанию 3001.
PORT=3001

# Режим работы приложения.
# Если задать production, сервер дополнительно раздаёт собранный клиент
# из client/dist на том же порту (single-port). Для разработки не задавайте.
# NODE_ENV=production

# Зеркала PokerDom (курс USD->RUB) через запятую, перебираются по порядку.
# Пустое/отсутствующее значение => используются зеркала по умолчанию из кода.
# POKERDOM_MIRRORS=https://pd-play-x7wq3.com/poker,https://plk7pokerdom.com/poker
